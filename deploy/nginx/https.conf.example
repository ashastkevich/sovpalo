# Включается после выпуска сертификата: cp https.conf.example default.conf
server {
    listen 80 default_server;
    server_name _;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://sovpalo.net$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name www.sovpalo.net;
    ssl_certificate /etc/letsencrypt/live/sovpalo.net/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/sovpalo.net/privkey.pem;
    return 301 https://sovpalo.net$request_uri;
}

server {
    listen 443 ssl default_server;
    http2 on;
    server_name sovpalo.net;
    ssl_certificate /etc/letsencrypt/live/sovpalo.net/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/sovpalo.net/privkey.pem;
    add_header Strict-Transport-Security "max-age=31536000" always;

    location / {
        include /etc/nginx/conf.d/proxy.inc;
    }
}
