# Скопируйте в .env.local и поправьте под себя. Секретов в репозитории нет (ADR-0001, раздел 8).
DATABASE_URL=postgres://sovpalo:sovpalo@localhost:5433/sovpalo
SITE_URL=http://localhost:3000
# До открытия каталога false: noindex и запрет в robots.txt (NFR-7)
SITE_INDEXING=false
# preview | open
SITE_STAGE=preview
# Номер счётчика Яндекс Метрики: без него нет ни счётчика, ни баннера cookie
# METRIKA_ID=
# Ссылка на политику обработки данных для баннера cookie
# POLICY_URL=
NEXT_TELEMETRY_DISABLED=1
